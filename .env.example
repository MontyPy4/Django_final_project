# =====================================================================
# .env.example — шаблон для .env
# Скопируй в .env: cp .env.example .env  (Linux/macOS)
#                   copy .env.example .env  (Windows)
# и заполни реальными значениями. Файл .env в git НЕ коммитится.
# =====================================================================

# --- Django core ---
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace_with_50_chars_random_string

# True для разработки, False для прода
DEBUG=True

# Список через запятую. На проде без * и без localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database switch ---
# True  -> используется SQLite (db.sqlite3 в корне проекта), MySQL не нужна
# False -> используется MySQL (см. ниже)
USE_SQLITE=True

# --- MySQL ---
# В Docker compose эти значения используются для контейнера db.
# Без Docker — указывай адрес реального MySQL сервера.
# DB_HOST в Docker автоматически переопределяется на 'db'.
DB_NAME=rental_db
DB_USER=rental_user
DB_PASSWORD=replace_me_strong_password
DB_ROOT_PASSWORD=replace_me_root_password
DB_HOST=localhost
DB_PORT=3306

# --- Redis ---
# В Docker эта переменная переопределяется compose'ом на redis://redis:6379/1.
# Без Docker — закомментируй, и Django фолбэкнется на in-memory cache.
# REDIS_URL=redis://localhost:6379/1

# --- MongoDB для логов ---
# Кастомный MongoLogHandler пишет туда логи django.request и бизнес-событий.
# При недоступности Mongo handler делает back-off, приложение не падает.
MONGO_URI=mongodb://user:password@host:27017/?authSource=admin
MONGO_DB=rental_logs
MONGO_COLLECTION=app_logs

# --- CORS (только для production, когда DEBUG=False) ---
# В dev режиме игнорируется (стоит CORS_ALLOW_ALL_ORIGINS=True).
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com,https://www.example.com
